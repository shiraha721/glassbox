# Copy to .env and configure locally. Never commit real credentials.
STUDIO_DATA_DIR=var
STUDIO_WORKSPACE_ROOT=.
STUDIO_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Provider configuration stores this variable's NAME, not its secret value.
OPENAI_API_KEY=
# Windows uses the default WSL distribution when blank. Linux uses local bubblewrap.
STUDIO_WSL_DISTRO=
