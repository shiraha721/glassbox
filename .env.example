# Copy to .env and configure locally. Never commit real credentials.
# Optional: providers, models and API keys can also be configured in Settings.
STUDIO_DATA_DIR=var
STUDIO_WORKSPACE_ROOT=.
STUDIO_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Provider configuration stores this variable's NAME, not its secret value.
OPENAI_API_KEY=
# For Anthropic Messages, set STUDIO_PROVIDER=anthropic and uncomment these options.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=
